# Cloudflare Pages response headers for the static client (R20, D81). API responses through the Function get helmet's.
# The script hash is the inline theme script in index.html; client test DEP-TC23 fails when the two drift apart.
# Image and audio hosts: Unsplash backgrounds, Jamendo covers and streams. Sentry only receives events when
# VITE_SENTRY_DSN is set. wss: lets the same-origin Socket.io connection through in browsers whose 'self' omits wss.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-dfWB4nSaAGTYvgB6Erj0rbJovKSJB/WKBJ63PD9S0Wg='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.unsplash.com https://*.jamendo.com; media-src 'self' blob: https://*.jamendo.com; font-src 'self' data:; connect-src 'self' wss: https://*.sentry.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=()

# Hashed file names, so a year is safe. index.html keeps Pages' default (max-age=0, must-revalidate); a Cache-Control
# on /* would be joined onto this one, because Pages merges every matching rule.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
