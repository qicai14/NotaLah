DATABASE_URL=postgres://notalah:notalah@localhost:5433/notalah?sslmode=disable
TEST_DATABASE_URL=postgres://notalah:notalah@localhost:5433/notalah_test?sslmode=disable
JWT_SECRET=replace-with-a-long-random-string
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Secure flag on the auth cookie (D35); defaults to true only when NODE_ENV=production. Set true for any HTTPS deployment.
# COOKIE_SECURE=false
# Proxy hops in front of the API (D65): loopback (default) trusts the Vite dev proxy; set 1 on Render. Never true:
# that lets any client forge X-Forwarded-For and dodge the per-IP rate limits. Production refuses loopback.
# TRUST_PROXY=loopback
# Postgres pool tuning (D34); the defaults suit one small instance.
# PG_POOL_MAX=10                  # most connections the pool opens; keep below the database's connection limit
# PG_IDLE_TIMEOUT_MS=30000        # close a connection idle this long
# PG_CONNECTION_TIMEOUT_MS=10000  # fail if no connection is ready (pool busy or database waking) within this long
# Optional error tracking (D41). Unset = @sentry/node is never loaded and nothing is sent.
# SENTRY_DSN=
# Only read by `vp run server#admin:create` (creates the first admin, D6). Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Upload folder for the local storage driver (D54); default <repo>/uploads, gitignored.
# STORAGE_DIR=
# Storage driver (D60): local (default) or r2; r2 requires all four R2_* values (bucket-scoped Object Read & Write token).
# STORAGE_DRIVER=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Kill switch (R34): true refuses every upload with 503.
# UPLOADS_DISABLED=false
# Free-tier guard caps (R34, D57): defaults are 80% of storage and 50% of each other allowance. A value can only lower
# its cap; anything above the default falls back to it (logged).
# USAGE_CAP_STORAGE_BYTES=8000000000
# USAGE_CAP_CLASS_A=500000
# USAGE_CAP_CLASS_B=5000000
# USAGE_CAP_UNSPLASH=25
# Unsplash image search (R22). Unset = /api/unsplash answers 503 and the editor panel stays disabled.
# UNSPLASH_ACCESS_KEY=
