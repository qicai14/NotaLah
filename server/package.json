{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "dbmate --env-file ../.env --no-dump-schema up",
    "db:rollback": "dbmate --env-file ../.env --no-dump-schema rollback",
    "db:migrate:test": "dbmate --env-file ../.env --env TEST_DATABASE_URL --no-dump-schema up",
    "db:status": "dbmate --env-file ../.env --no-dump-schema status"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dbmate": "2.36.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
