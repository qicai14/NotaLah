{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "admin:create": "tsx src/scripts/createAdmin.ts",
    "load:seed": "tsx src/scripts/load/seed.ts",
    "load:run": "tsx src/scripts/load/run.ts",
    "load:latency": "tsx src/scripts/load/latency.ts",
    "db:migrate": "dbmate --env-file ../.env --no-dump-schema up",
    "db:rollback": "dbmate --env-file ../.env --no-dump-schema rollback",
    "db:migrate:test": "dbmate --env-file ../.env --env TEST_DATABASE_URL --no-dump-schema up",
    "db:status": "dbmate --env-file ../.env --no-dump-schema status"
  },
  "dependencies": {
    "@notalah/shared": "workspace:*",
    "@sentry/node": "11.8.0",
    "aws4fetch": "1.0.20",
    "bcryptjs": "3.0.3",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "catalog:",
    "@types/passport": "1.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "7.2.1",
    "dbmate": "2.36.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
