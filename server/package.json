{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "admin:create": "tsx src/scripts/createAdmin.ts",
    "db:purge-interactions": "tsx src/scripts/purgeInteractions.ts",
    "db:migrate": "dbmate --env-file ../.env --no-dump-schema up",
    "db:rollback": "dbmate --env-file ../.env --no-dump-schema rollback",
    "db:migrate:test": "dbmate --env-file ../.env --env TEST_DATABASE_URL --no-dump-schema up",
    "db:status": "dbmate --env-file ../.env --no-dump-schema status"
  },
  "dependencies": {
    "@sentry/node": "10.75.3",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "sanitize-html": "2.17.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.0",
    "@types/passport": "1.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.1",
    "@types/supertest": "7.2.1",
    "dbmate": "2.36.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "vite-plus": "1.0.0"
  }
}
