@startuml act_post_anchored_message
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam dpi 170
skinparam ActivityBackgroundColor white
skinparam SwimlaneWidth same
|Sender|
start
:Select "Message author" on a note;
|System|
:Open chat window with note card attached;
|Sender|
:Type message and send;
|System|
if (Sender and author are contacts?) then (yes)
  :Find or create direct conversation;
  :Store message with note reference;
  :Push message to recipient in real time;
  stop
else (no)
endif
if (Pending request already exists?) then (yes)
  :Tell sender a request is already pending;
  stop
else (no)
endif
:Store message request with note reference\n(status "pending");
:Notify recipient of new request;
:Tell sender "Request sent";
|Recipient|
:Open Message Requests;
:Read first message and note card;
if (Accept?) then (yes)
  |System|
  :Add both users to CONTACT_T;
  :Create direct conversation;
  :Move held message into conversation;
  :Notify sender in real time;
  |Sender|
  :Continue conversation as contacts;
  stop
else (no)
  |System|
  :Mark request "declined"\n(sender not notified);
  stop
endif
@enduml
