@startuml seq_annotate_note
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam dpi 170
skinparam sequenceMessageAlign center
autonumber
hide footbox
actor "Student / Lecturer" as U
participant "React Client\n(Note View)" as C
participant "Auth Middleware\n(Passport JWT)" as A
participant "AnnotationRoutes" as AR
participant "NotificationService" as NS
database "PostgreSQL" as DB
actor "Note Author" as N

U -> C : Select text in a slide, click "Annotate",\ntype annotation
C -> A : POST /api/notes/:id/annotations\n{slideId, elementId, quote, offset, body}
A -> A : Verify token, load user
alt token invalid or account not active
  A --> C : 401 Unauthorized / 403 Forbidden
  C --> U : Redirect to login / show error
else valid
  A -> AR : forward request with req.user
  AR -> DB : SELECT pst_usr_id, pst_annotations_on FROM "POST_T"\nWHERE published AND visible to user (friends, blocks)
  alt note not visible
    AR --> C : 404 Note not found
  else annotations switched off
    AR --> C : 403 Annotations are turned off
    C --> U : Show message
  else allowed
    AR -> AR : Validate body, quote, offset,\nslideId and elementId with zod
    AR -> DB : SELECT element type FROM "SLIDE_T"\nWHERE note, slide position and element id match
    alt invalid or element is not text
      AR --> C : 400 {errors}
      C --> U : Show the limit or message
    else valid
      AR -> DB : INSERT INTO "ANNOTATION_T" ... RETURNING ant_id
      AR -> NS : notify(annotation, actor, note, [author])
      NS -> DB : INSERT INTO "NOTIFICATION_T"\n(skipped for self or a block)
      NS -> N : emit notification:new to room user:{author}
      AR --> C : 201 {annotation}
      C --> U : Highlight the text and\nlist the annotation in the side panel
    end
  end
end
@enduml
