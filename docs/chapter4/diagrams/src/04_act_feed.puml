@startuml act_ranked_feed
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam dpi 170
skinparam ActivityBackgroundColor white
skinparam SwimlaneWidth same
|Student / Lecturer|
start
:Open Feed;
|System|
:Retrieve published notes visible to viewer\n(public, or contacts-only from a contact);
if (Any candidate notes?) then (no)
  :Show empty-feed message\nwith Search and Create Note links;
  stop
else (yes)
endif
:Build viewer interest vector from\ninteractions with 14-day decay;
fork
  :raw = likes + 2 x comments\nE = min(1, log10(1 + raw) / log10(1 + cap));
fork again
  :R = 0.5 ^ (age hours / 72);
fork again
  :V = 1.0 if Super Liked,\n0.5 if lecturer-authored, else 0;
fork again
  :M = mean interest weight\nof the note's hashtags;
end fork
:S = w1E + w2R + w3V + w4M\n(weights from ranking config);
:Sort by S descending and return first page;
|Student / Lecturer|
repeat
  :View note in slide viewer\n(swipe horizontally between slides);
  |System|
  :Record "view" interaction;
  |Student / Lecturer|
  if (Interact with note?) then (yes)
    :Like / comment / bookmark /\nreport / message author;
  else (no)
  endif
  :Scroll to next note;
  |System|
  if (Near end of page?) then (yes)
    :Load next ranked page;
  else (no)
  endif
  |Student / Lecturer|
repeat while (Continue browsing?) is (yes) not (no)
stop
@enduml
