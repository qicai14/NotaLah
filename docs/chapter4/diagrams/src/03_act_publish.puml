@startuml act_publish_note
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam dpi 170
skinparam ActivityBackgroundColor white
skinparam SwimlaneWidth same
|Student / Lecturer|
start
:Select "Create Note";
|System|
:Open slide editor with one blank slide;
|Student / Lecturer|
repeat
  :Write or edit slide content;
  :Add, reorder or remove slides;
repeat while (More slides to edit?) is (yes) not (no)
:Select module and enter hashtags;
if (Publish now?) then (no)
  |System|
  :Save note with status "draft";
  :Show "Draft saved" with time;
  stop
else (yes)
  |Student / Lecturer|
  :Select "Publish";
endif
|System|
:Show visibility options\n(Public / Contacts only / Private draft)\nat equal prominence;
|Student / Lecturer|
:Choose visibility;
|System|
if (Title, slide content, module\nand 1-5 valid hashtags present?) then (no)
  :List missing items;
  |Student / Lecturer|
  :Return to editor;
  stop
else (yes)
endif
|System|
:Normalise hashtags (lowercase, strip #)\nand create unknown hashtags;
:Store slides, hashtags, visibility\nand publication time;
:Build full-text search document;
:Open published note;
if (Author is approved lecturer?) then (yes)
  :Show lecturer checkmark badge;
else (no)
endif
stop
@enduml
