{
  "name": "parp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "test": "npm test -w server && npm test -w client",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "vp lint",
    "format:check": "vp fmt --check"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-floating-menu": "3.31.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.15"
  }
}
