{
  "name": "notalah",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "test:e2e": "vp exec playwright test -c e2e/playwright.config.ts",
    "test:lighthouse": "vp exec playwright test -c e2e/playwright.lighthouse.config.ts",
    "prepare": "vp config && vp run @notalah/shared#build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@swc/core": "1.16.22",
    "@types/node": "catalog:",
    "dependency-cruiser": "18.9.0",
    "lighthouse": "13.6.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.22.0"
  },
  "packageManager": "pnpm@12.14.0"
}
