{
  "name": "parp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "dev": "concurrently -n shared,server,client -c yellow,blue,green \"pnpm --filter @parp/shared dev\" \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "test": "pnpm --filter server test && pnpm --filter client test",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "vp lint",
    "format:check": "vp fmt --check",
    "prepare": "vp config && pnpm --filter @parp/shared build"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "packageManager": "pnpm@12.9.1"
}
